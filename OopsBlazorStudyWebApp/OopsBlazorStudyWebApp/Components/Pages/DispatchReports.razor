@page "/dispatch-reports"

<PageTitle>Dispatch Reports</PageTitle>

<section class="master-shell">
    <div class="master-header">
        <div>
            <p class="section-kicker">Dispatch</p>
            <h1 class="page-title">Dispatch Reports</h1>
            <p class="page-subtitle">
                Report section for dispatch activity, outbound movement, and client handover tracking.
            </p>
        </div>
        <div class="header-note-card">
            <span class="header-note-label">Reports section</span>
            <strong>Dispatch</strong>
            <p>Use this area for dispatch-wise reporting screens.</p>
        </div>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2 class="panel-title">Dispatch report workspace</h2>
                <p class="panel-subtitle">Report filters and grids can be added here next.</p>
            </div>
            <span class="pill pill-teal">Ready</span>
        </div>
    </section>
</section>
