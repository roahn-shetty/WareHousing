@page "/production-reports"

<PageTitle>Production Reports</PageTitle>

<section class="master-shell">
    <div class="master-header">
        <div>
            <p class="section-kicker">Production</p>
            <h1 class="page-title">Production Reports</h1>
            <p class="page-subtitle">
                Report section for production movement, job activity, and operational tracking.
            </p>
        </div>
        <div class="header-note-card">
            <span class="header-note-label">Reports section</span>
            <strong>Production</strong>
            <p>Use this area for production-wise reporting screens.</p>
        </div>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2 class="panel-title">Production report workspace</h2>
                <p class="panel-subtitle">Report filters and grids can be added here next.</p>
            </div>
            <span class="pill pill-teal">Ready</span>
        </div>
    </section>
</section>
