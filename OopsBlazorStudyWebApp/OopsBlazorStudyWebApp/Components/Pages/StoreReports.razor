@page "/store-reports"

<PageTitle>Store Reports</PageTitle>

<section class="master-shell">
    <div class="master-header">
        <div>
            <p class="section-kicker">Store</p>
            <h1 class="page-title">Store Reports</h1>
            <p class="page-subtitle">
                Report section for store transactions, stock movement, and warehouse visibility.
            </p>
        </div>
        <div class="header-note-card">
            <span class="header-note-label">Reports section</span>
            <strong>Store</strong>
            <p>Use this area for store-wise reporting screens.</p>
        </div>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2 class="panel-title">Store report workspace</h2>
                <p class="panel-subtitle">Report filters and grids can be added here next.</p>
            </div>
            <span class="pill pill-teal">Ready</span>
        </div>
    </section>
</section>
