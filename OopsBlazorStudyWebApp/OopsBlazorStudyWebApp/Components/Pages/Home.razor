@page "/"

@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMenuMasterRepository MenuMasterRepository

<PageTitle>Warehouse Dashboard</PageTitle>

<section class="dashboard-shell">
    <div class="hero-panel">
        <div>
            <p class="section-kicker">&nbsp;</p>
            <h1 class="page-title">WMS Dashboard</h1>
        </div>
    </div>

    <div class="metric-grid">
        @foreach (var metric in DashboardMetrics)
        {
            <article class="metric-card @metric.AccentClass">
                <span class="metric-label">@metric.Label</span>
                <strong>@metric.Value</strong>
                <span class="metric-meta">@metric.Meta</span>
            </article>
        }
    </div>

    <div class="dashboard-grid dashboard-grid-wide">
        <section class="panel panel-large">
            <div class="panel-heading">
                <div>
                    <h2 class="panel-title">Inbound vs outbound activity</h2>
                    <p class="panel-subtitle">Last six warehouse windows mapped as a quick planning graph.</p>
                </div>
                <span class="pill pill-teal">Live trend</span>
            </div>

            <div class="bar-chart">
                @foreach (var point in ActivityChart)
                {
                    <div class="bar-group">
                        <div class="bar-stack">
                            <div class="bar bar-inbound" style="@($"--bar-height:{point.InboundPercent}%")"></div>
                            <div class="bar bar-outbound" style="@($"--bar-height:{point.OutboundPercent}%")"></div>
                        </div>
                        <div class="bar-legend">
                            <span>@point.Month</span>
                            <small>@point.Inbound / @point.Outbound</small>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h2 class="panel-title">Storage utilization</h2>
                    <p class="panel-subtitle">Current balance between stocking capacity and admin readiness.</p>
                </div>
            </div>

            <div class="ring-chart" style="@($"--ring-value:{StorageUtilization}")">
                <div class="ring-center">
                    <strong>@StorageUtilization%</strong>
                    <span>utilized</span>
                </div>
            </div>

            <div class="legend-list">
                @foreach (var item in UtilizationLegend)
                {
                    <div class="legend-item">
                        <span class="legend-swatch @item.AccentClass"></span>
                        <div>
                            <strong>@item.Label</strong>
                            <small>@item.Value</small>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="dashboard-grid">
        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h2 class="panel-title">Main Modules</h2>
                    <p class="panel-subtitle">Click a module to view its available screens.</p>
                </div>
            </div>

            <div class="module-switcher">
                @foreach (var moduleGroup in DashboardModuleGroups)
                {
                    <button type="button" class="module-switch-card @(selectedModuleKey == moduleGroup.Key ? "active" : string.Empty)" @onclick="() => SelectDashboardModule(moduleGroup.Key)">
                        <span class="module-switch-icon">@moduleGroup.Icon</span>
                        <span class="module-switch-copy">
                            <strong>@moduleGroup.Title</strong>
                            <small>@moduleGroup.Summary</small>
                        </span>
                    </button>
                }
            </div>

            <div class="module-detail-panel">
                <div class="module-detail-heading">
                    <span class="module-detail-icon">@SelectedModule.Icon</span>
                    <div>
                        <h3>@SelectedModule.Title Details</h3>
                        <p>@SelectedModule.Summary</p>
                    </div>
                </div>

                @if (SelectedModule.Links.Length == 0)
                {
                    <p class="empty-state">No active Menu Master records are linked with existing pages for this module.</p>
                }
                else
                {
                    <div class="quick-links-grid module-detail-grid">
                        @foreach (var module in SelectedModule.Links)
                        {
                            <a class="quick-link-card" href="@module.Href">
                                <span class="quick-link-badge">@module.Code</span>
                                <div>
                                    <strong>@module.Title</strong>
                                    <p>@module.Description</p>
                                </div>
                                <span class="link-note">@module.Note</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h2 class="panel-title">Priority actions</h2>
                    <p class="panel-subtitle">Recommended checks before the next client handover.</p>
                </div>
            </div>

            <div class="activity-list">
                @foreach (var action in PriorityActions)
                {
                    <article class="activity-item">
                        <div class="activity-marker @action.AccentClass"></div>
                        <div class="activity-copy">
                            <strong>@action.Title</strong>
                            <p>@action.Description</p>
                        </div>
                        <span class="activity-time">@action.When</span>
                    </article>
                }
            </div>
        </section>
    </div>
</section>

@code {
    private const int StorageUtilization = 78;
    private string selectedModuleKey = "master";
    private int activeMenuCount;
    private int totalMenuCount;
    private DashboardModuleGroup[] dashboardModuleGroups = BuildDashboardModuleGroups(
        Array.Empty<MenuNavigationLink>(),
        Array.Empty<MenuNavigationLink>(),
        Array.Empty<MenuNavigationLink>(),
        Array.Empty<MenuNavigationLink>());
    private static readonly DashboardModuleGroup EmptyModuleGroup = new("none", "🔒", "No Menus", "No role menu permissions assigned.", Array.Empty<ModuleLink>());

    private DashboardModuleGroup SelectedModule =>
        DashboardModuleGroups.FirstOrDefault(module => module.Key == selectedModuleKey) ??
        DashboardModuleGroups.FirstOrDefault() ??
        EmptyModuleGroup;

    private IReadOnlyList<DashboardModuleGroup> DashboardModuleGroups => dashboardModuleGroups;

    private DashboardMetric[] DashboardMetrics =>
        new DashboardMetric[]
        {
            new DashboardMetric("Active Users", "148", "12 users pending right review", "metric-card-teal"),
            new DashboardMetric("Printers Online", "18", "2 devices awaiting IP confirmation", "metric-card-amber"),
            new DashboardMetric("Roles Configured", "06", "1 custom role added this week", "metric-card-slate"),
            new DashboardMetric("Menus Published", activeMenuCount.ToString("00"), $"{totalMenuCount:00} Menu Master records", "metric-card-cyan")
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuMasterModulesAsync();
    }

    private async Task LoadMenuMasterModulesAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userMasterIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userMasterIdClaim, out var userMasterId) || userMasterId <= 0)
            {
                dashboardModuleGroups = BuildDashboardModuleGroups(
                    Array.Empty<MenuNavigationLink>(),
                    Array.Empty<MenuNavigationLink>(),
                    Array.Empty<MenuNavigationLink>(),
                    Array.Empty<MenuNavigationLink>());
                EnsureSelectedDashboardModule();
                return;
            }

            var menus = await MenuMasterRepository.GetMenusForUserAsync(userMasterId);
            var masterLinks = MenuNavigationCatalog.GetActiveMasterLinks(menus);
            var storeLinks = MenuNavigationCatalog.GetActiveStoreLinks(menus);
            var productionLinks = MenuNavigationCatalog.GetActiveProductionLinks(menus);
            var dispatchLinks = MenuNavigationCatalog.GetActiveDispatchLinks(menus);

            totalMenuCount = menus.Count;
            activeMenuCount = menus.Count(menu =>
                string.Equals(menu.Status, "Activate", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(menu.Status, "Active", StringComparison.OrdinalIgnoreCase));
            dashboardModuleGroups = BuildDashboardModuleGroups(masterLinks, storeLinks, productionLinks, dispatchLinks);
            EnsureSelectedDashboardModule();
        }
        catch
        {
            activeMenuCount = 0;
            totalMenuCount = 0;
            dashboardModuleGroups = BuildDashboardModuleGroups(
                Array.Empty<MenuNavigationLink>(),
                Array.Empty<MenuNavigationLink>(),
                Array.Empty<MenuNavigationLink>(),
                Array.Empty<MenuNavigationLink>());
            EnsureSelectedDashboardModule();
        }
    }

    private static readonly ActivityChartPoint[] ActivityChart =
    {
        new("Apr", 48, 42, 72, 63),
        new("May", 56, 49, 82, 72),
        new("Jun", 60, 52, 88, 76),
        new("Jul", 64, 58, 94, 84),
        new("Aug", 70, 61, 100, 88),
        new("Sep", 66, 55, 94, 79)
    };

    private static readonly LegendMetric[] UtilizationLegend =
    {
        new("Rack capacity", "312 bins in use", "legend-teal"),
        new("Dispatch staging", "44 loads queued", "legend-amber"),
        new("Admin readiness", "4 masters synchronized", "legend-cyan")
    };

    private static DashboardModuleGroup[] BuildDashboardModuleGroups(
        IReadOnlyList<MenuNavigationLink> masterLinks,
        IReadOnlyList<MenuNavigationLink> storeLinks,
        IReadOnlyList<MenuNavigationLink> productionLinks,
        IReadOnlyList<MenuNavigationLink> dispatchLinks)
    {
        var groups = new List<DashboardModuleGroup>();

        if (masterLinks.Count > 0)
        {
            groups.Add(new DashboardModuleGroup(
                "master",
                "🧩",
                "Master",
                "Permitted master screens from Role Master",
                ToModuleLinks(masterLinks)));
        }

        if (storeLinks.Count > 0)
        {
            groups.Add(new DashboardModuleGroup(
                "store",
                "📦",
                "Store",
                "Permitted store screens from Role Master",
                ToModuleLinks(storeLinks)));
        }

        if (productionLinks.Count > 0)
        {
            groups.Add(new DashboardModuleGroup(
                "production",
                "⚙️",
                "Production",
                "Permitted production screens from Role Master",
                ToModuleLinks(productionLinks)));
        }

        if (dispatchLinks.Count > 0)
        {
            groups.Add(new DashboardModuleGroup(
                "dispatch",
                "🚚",
                "Dispatch",
                "Permitted dispatch screens from Role Master",
                ToModuleLinks(dispatchLinks)));
        }

        return groups.ToArray();
    }

    private static ModuleLink[] ToModuleLinks(IReadOnlyList<MenuNavigationLink> links) =>
        links
            .Select(link => new ModuleLink(link.Icon, link.MenuName, link.Description, link.Href, link.Note))
            .ToArray();

    private static readonly ActivityTask[] PriorityActions =
    {
        new("Review newly created dispatch users", "Validate roles before they receive printer and menu access.", "09:30 AM", "activity-teal"),
        new("Confirm IP address mapping for dock printers", "Cross-check printer IDs with their assigned warehouse zones.", "11:15 AM", "activity-amber"),
        new("Publish menu visibility for supervisors", "Ensure the menu master reflects the latest role matrix.", "02:00 PM", "activity-cyan"),
        new("Audit inactive accounts", "Deactivate dormant users before the evening operational shift.", "04:45 PM", "activity-slate")
    };

    private sealed record DashboardMetric(string Label, string Value, string Meta, string AccentClass);
    private sealed record ActivityChartPoint(string Month, int Inbound, int Outbound, int InboundPercent, int OutboundPercent);
    private sealed record LegendMetric(string Label, string Value, string AccentClass);
    private sealed record DashboardModuleGroup(string Key, string Icon, string Title, string Summary, ModuleLink[] Links);
    private sealed record ModuleLink(string Code, string Title, string Description, string Href, string Note);
    private sealed record ActivityTask(string Title, string Description, string When, string AccentClass);

    private void SelectDashboardModule(string key)
    {
        selectedModuleKey = key;
    }

    private void EnsureSelectedDashboardModule()
    {
        if (dashboardModuleGroups.Length > 0 &&
            !dashboardModuleGroups.Any(module => module.Key == selectedModuleKey))
        {
            selectedModuleKey = dashboardModuleGroups[0].Key;
        }
    }
}
